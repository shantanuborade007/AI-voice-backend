NODE_ENV=development
PORT=3000

# Logging (winston). One of: error, warn, info, debug
LOG_LEVEL=debug

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=smb_voice_platform
# Schema is created via db/migrations/*.sql (run `npm run db:migrate`), not TypeORM sync.

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Seed admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Telephony / voice (wire up once Exotel KYC is approved)
# Platform-level fact: Exotel account KYC is a one-time check on the whole
# account, not per-business. Flip to true once KYC clears.
EXOTEL_ACCOUNT_KYC_APPROVED=false
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
SARVAM_AI_API_KEY=
